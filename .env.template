# -----------------------------------------------------------------------------
# TEMPLATE ONLY — DO NOT USE AS REAL SECRETS
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.template .env.local
#
# `.env.local` must NEVER be committed (see .gitignore).
# WARNING: NEVER put secrets in NEXT_PUBLIC_* variables.
#
# BODT Strategy: Build Once, Deploy Twice
#
# In a typical BODT setup, client-side variables (NEXT_PUBLIC_*) are NOT
# baked in at build time. Instead, they can be injected at runtime, for example:
#   1. Server reads process.env during layout rendering
#   2. Serializes to <script>window.__ENV = {...}</script>
#   3. Client accesses values via a small env(key) helper
#
# This pattern allows the same Docker image to run in staging and production
# with different API endpoints.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Build-Time Configuration
# -----------------------------------------------------------------------------
# Required — Node environment (default: development).
NODE_ENV=development

# -----------------------------------------------------------------------------
# Runtime Configuration (Server-Side)
# -----------------------------------------------------------------------------
# Required — Internal backend URL (server-to-server).
API_URL=http://localhost:8000
# Optional — OpenTelemetry collector endpoint (server only).
OTEL_ENDPOINT=

# -----------------------------------------------------------------------------
# Runtime Configuration (Client-Side via window.__ENV)
# -----------------------------------------------------------------------------
# Required — Public backend URL for browser requests (safe for client).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional — Client-side Sentry DSN (safe for client).
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Optional — Enable Creation Studio (default: true, safe for client).
NEXT_PUBLIC_FEATURE_CREATION_STUDIO=true
# Optional — Enable social features (default: false, safe for client).
NEXT_PUBLIC_FEATURE_SOCIAL=false
